# Copia este archivo como .env y rellénalo. ¡Nunca subas el .env a GitHub!

# Dirección pública de la web (se usa en los enlaces de los emails)
URL_BASE=http://localhost:3000
PORT=3000

# Contraseña del panel del restaurante (/admin.html). Pon una larga y única.
ADMIN_PASSWORD=

# Email (Gmail): activa la verificación en 2 pasos en la cuenta y crea una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=grupocuadrilla@gmail.com
SMTP_PASS=

# Opcionales
# RESTAURANTE_NOMBRE=Cuadrilla Sky
# RESTAURANTE_DIRECCION=Paseo de la Castellana, 259, Madrid
# RESTAURANTE_EMAIL=grupocuadrilla@gmail.com
